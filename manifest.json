
{
  "manifest_version": 3,
  "name": "Video Downloader",
  "version": "0.1.0",
  "description": "Detect videos and prepare downloads.",
  "action": {
    "default_title": "Video Downloader",
    "default_popup": "popup/popup.html"
  },
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "nativeMessaging"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
